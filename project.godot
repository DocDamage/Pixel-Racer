; Engine configuration file.
; Pixel Track Works - Godot 4.7.x
config_version=5

[application]
config/name="Pixel Track Works"
config/description="Top-down arcade racing and track construction sandbox"
config/auto_accept_quit=false
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
GameState="*res://autoload/game_state.gd"
SaveManager="*res://autoload/save_manager.gd"
SettingsManager="*res://autoload/settings_manager.gd"
InputManager="*res://autoload/input_manager.gd"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[physics]
common/physics_ticks_per_second=60
